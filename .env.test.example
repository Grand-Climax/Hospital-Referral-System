# ─────────────────────────────────────────────────────────────────────────────
# Hospital Referral System - E2E Testing Environment Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.test (or .env.test.local) to configure an isolated
# testing environment.
#
# IMPORTANT: Never point DATABASE_URL here to your primary or production database.
# E2E test runs auto-seed and create test fixtures.
# ─────────────────────────────────────────────────────────────────────────────

# Target backend server URL for E2E HTTP requests
BASE_URL=http://localhost:8081
PORT=8081

# Dedicated Test Database Connection
# Use a local PostgreSQL test database (e.g., referral_test or hospital_e2e_test)
DATABASE_URL=host=localhost user=postgres password=postgres dbname=referral_test port=5432 sslmode=disable TimeZone=Africa/Addis_Ababa

# Set to true to skip auto-seeding if the test database is already populated
E2E_SKIP_SEED=false

# Safety override (defaults to false). Only set to true if you are running
# against an intentionally remote test database instance.
ALLOW_REMOTE_E2E_DB=false
